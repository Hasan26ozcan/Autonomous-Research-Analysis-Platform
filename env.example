# Copy this file to .env and fill in real values before running the app.
# Every variable below has a sensible default in app/core/config.py,
# so you only need to override what's different in your environment
# (at minimum: OPENAI_API_KEY).

# ── LLM Models ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
ROUTER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
TEMPERATURE=0.1
MAX_TOKENS=2048
MAX_RETRIES=2

# ── Embedding ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Qdrant — Vector Database ──────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arap_docs

# ── Neo4j — Knowledge Graph ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/arap

# ── Mem0 — Long-Term Memory ───────────────────────────────────────────────
# Leave MEM0_API_KEY empty to use a self-hosted Mem0 instance instead
# of the hosted Mem0 platform.
MEM0_API_KEY=
MEM0_BASE_URL=http://localhost:3000

# ── LangSmith — Observability ─────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=arap

# ── Retrieval Parameters ──────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_FINAL=5
RRF_K=60
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3

# ── Faithfulness Judge ─────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.75
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# ── Celery — Async Task Queue ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
