# Copy this file to .env and fill in real values before running the app.
# Every variable below has a sensible default in app/core/config.py,
# so you only need to override what's different in your environment
# (at minimum: OPENAI_API_KEY).

# ── LLM Models ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Leave LLM_BASE_URL empty to use OpenAI directly.
# To use a FREE alternative instead (no code changes needed, OpenAI
# integration stays exactly as-is, just points elsewhere):
#   Option A - Groq (free tier, no credit card, fast, hosted):
#     1. Sign up at https://console.groq.com  -> API Keys -> create one
#     2. OPENAI_API_KEY=<your Groq key>
#     3. LLM_BASE_URL=https://api.groq.com/openai/v1
#     4. Set LLM_MODEL / ROUTER_MODEL / JUDGE_MODEL below to a Groq model,
#        e.g. openai/gpt-oss-120b (LLM_MODEL) and
#        openai/gpt-oss-20b (ROUTER_MODEL / JUDGE_MODEL)
#        NOTE: Groq deprecates models periodically - check
#        https://console.groq.com/docs/models for the current list if
#        these stop working.
#   Option B - Ollama (fully local, no signup, no internet required):
#     1. Install Ollama, run: ollama pull llama3.1
#     2. OPENAI_API_KEY=ollama   (any non-empty string works)
#     3. LLM_BASE_URL=http://localhost:11434/v1
#     4. Set LLM_MODEL / ROUTER_MODEL / JUDGE_MODEL to llama3.1
LLM_BASE_URL=
LLM_MODEL=gpt-4o
ROUTER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
TEMPERATURE=0.1
MAX_TOKENS=2048
MAX_RETRIES=2

# ── Embedding ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Qdrant — Vector Database ──────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arap_docs

# ── Neo4j — Knowledge Graph ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/arap

# ── Mem0 — Long-Term Memory ───────────────────────────────────────────────
# Leave MEM0_API_KEY empty to use a self-hosted Mem0 instance instead
# of the hosted Mem0 platform.
MEM0_API_KEY=
MEM0_BASE_URL=http://localhost:3000

# ── LangSmith — Observability ─────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=arap

# ── Retrieval Parameters ──────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_FINAL=5
RRF_K=60
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3

# ── Faithfulness Judge ─────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.75
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# ── Celery — Async Task Queue ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
